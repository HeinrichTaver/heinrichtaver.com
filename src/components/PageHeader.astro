---
const { headerTitle } = Astro.props;

const navItems = [
  {
    label: "Home",
    href: "/",
    current: Astro.url.pathname === "/" ? "current" : null,
  },
  {
    label: "Now",
    href: "/now/",
    current: Astro.url.pathname === "/now/" ? "current" : null,
  },
  {
    label: "Blog",
    href: "/blog/",
    current: Astro.url.pathname.startsWith("/blog/") ? "current" : null,
  },

];
---

<header>
  <h1>{headerTitle}</h1>
  <nav>
    <ul>
      {navItems.map((item) => (
        <li class={item.current}><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
header {
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 1.5em 0;
  row-gap: 1em;
  user-select: none;
}

h1 {
  text-align: center;
}

ul {
  column-gap: 2.5em;
  display: flex;
}

a:hover {
  text-decoration: underline;
}

.current {
  font-weight: bold;
  pointer-events: none;
}
</style>
