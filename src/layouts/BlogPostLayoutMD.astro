---
import BaseLayout from "./BaseLayout.astro"

import "../styles/markdown.css";

const { frontmatter } = Astro.props;

const pageTitle = `${frontmatter.title} | Heinrich's Post`;
const pubDate = frontmatter.pubDate.slice(0,10);

const formattedDate = (timestamp) => {
  const [year, month, day] = pubDate.split("-");

  const months = [ "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December" ];
  const monthName = months[parseInt(month, 10) - 1];

  return `${year} ${monthName} ${parseInt(day, 10)}`;
}
---

<BaseLayout pageTitle={pageTitle} headerTitle={frontmatter.title}>
  <div>
    <a href="/blog/">Go back to the post list</a>
    <p>
      Written on <time datetime={pubDate}>{formattedDate(frontmatter.pubDate)}</time>.
    </p>
  </div>

  <slot />
</BaseLayout>

<style>
div {
  align-items: center;
  display: flex;
  flex-direction: column;
  row-gap: .5em;
}

p {
  font-size: 1rem;
  font-style: italic;
}
</style>
